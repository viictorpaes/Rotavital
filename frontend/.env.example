# ===================================================================
# Rota Vital - Variáveis de Ambiente do Frontend (React / Vite)
#
# Para utilizar localmente:
# 1. Copie este arquivo para .env.local:
#    cp .env.example .env.local
# 2. Ajuste os valores conforme o ambiente desejado.
# ===================================================================

# URL base da API Spring Boot
# - Em desenvolvimento (com Vite reverse proxy): use /api/v1
# - Em desenvolvimento (chamada direta): use http://localhost:8080/api/v1
# - Em produção: use a URL do seu servidor em nuvem (ex: https://api.rotavital.com.br/api/v1)
VITE_API_URL=/api/v1

# Tempo limite padrão para requisições HTTP (em milissegundos)
# Padrão: 10000 (10 segundos)
VITE_API_TIMEOUT_MS=10000

# Título da aplicação exibido no navegador
VITE_APP_TITLE=Rota Vital - Estoque Inteligente
