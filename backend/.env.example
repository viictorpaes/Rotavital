# Exemplo de variaveis de ambiente para o Rotavital Backend
# Copie este arquivo para .env e preencha sua senha real:
SUPABASE_DB_PASSWORD=SUA_SENHA_AQUI

# Login (Supabase Auth): chave publicável do projeto, em Project Settings > API Keys
SUPABASE_KEY=SUA_CHAVE_PUBLICAVEL_AQUI

# Rota até o hospital (PI3-262): chave do Google com a Routes API ligada. Opcional: sem ela, vale a estimativa
GOOGLE_MAPS_API_KEY=SUA_CHAVE_DO_GOOGLE_AQUI