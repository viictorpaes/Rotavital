# Exemplo de variaveis de ambiente para o Rotavital Backend
# Copie para backend/.env e substitua os valores pelos dados do seu projeto Supabase.
# URL e chave anon: Connect / Project Settings > API e API Keys no painel Supabase.
# Use somente a chave publica anon/publishable; nunca use service_role/secret aqui.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_KEY=SUA_CHAVE_ANON_AQUI

# Senha do banco (Project Settings > Database > Database password)
SUPABASE_DB_PASSWORD=SUA_SENHA_AQUI

