# ===================================================================
# Rota Vital — variáveis do docker compose (compose.yaml).
#
#   cp .env.example .env    
# o .env está no .gitignore: nunca vai para o Git
#
# Só o Postgres local do Compose usa estas credenciais. Em produção (Render),
# a senha do Supabase fica nas variáveis secretas do serviço, não aqui.
# ===================================================================

# Banco local (container "db")
DB_NAME=rotavital
DB_USER=rotavital
DB_PASSWORD=senha_exemplo_rotavital

# Portas publicadas na sua máquina
API_PORT=8080
WEB_PORT=80
