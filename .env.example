# ===================================================================
# Rota Vital — variáveis do docker compose (compose.yaml e compose.supabase.yaml).
#
#   cp .env.example .env
# o .env está no .gitignore: nunca vai para o Git
#
# Em produção (Render), as mesmas chaves ficam nas variáveis secretas do serviço, não aqui.
# ===================================================================

# Banco local (container "db")
DB_NAME=rotavital
DB_USER=rotavital
DB_PASSWORD=senha_exemplo_rotavital

# Chave publicável do Supabase Auth (Project Settings > API Keys). O login e o cadastro
# de doador conferem a senha lá, também com o banco local. Sem ela, respondem 503.
SUPABASE_KEY=

# Só para o compose.supabase.yaml: senha do banco do Supabase (Project Settings > Database).
SUPABASE_DB_PASSWORD=

# Portas publicadas na sua máquina
API_PORT=8080
WEB_PORT=80
