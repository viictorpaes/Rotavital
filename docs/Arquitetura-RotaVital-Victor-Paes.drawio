        <mxCell id="sub_publica" value="&lt;b&gt;SUB-REDE PÚBLICA&lt;/b&gt;&lt;br&gt;sub-publica · 10.0.1.0/24&lt;br&gt;entrada: 0.0.0.0/0 → TCP 443&lt;br&gt;saída: 10.0.10.0/24 → TCP 8080" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="redes" vertex="1">
          <mxGeometry x="380" y="125" width="330" height="590" as="geometry" />
        </mxCell>
        <mxCell id="sub_app" value="&lt;b&gt;SUB-REDE PRIVADA DE APLICAÇÃO&lt;/b&gt;&lt;br&gt;sub-app · 10.0.10.0/24&lt;br&gt;entrada: somente 10.0.1.0/24 → TCP 8080&lt;br&gt;saída: somente 10.0.20.0/24 → TCP 5432" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" parent="redes" vertex="1">
          <mxGeometry x="780" y="125" width="420" height="590" as="geometry" />
        </mxCell>
        <mxCell id="sub_dados" value="&lt;b&gt;SUB-REDE PRIVADA DE DADOS&lt;/b&gt;&lt;br&gt;sub-dados · 10.0.20.0/24&lt;br&gt;entrada: somente 10.0.10.0/24 → TCP 5432&lt;br&gt;saída: nenhuma (sem internet)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="redes" vertex="1">
          <mxGeometry x="1270" y="125" width="315" height="590" as="geometry" />
        </mxCell>
        <mxCell id="osrm" value="&lt;b&gt;OSRM&lt;/b&gt; (terceiro)&lt;br&gt;router.project-osrm.org&lt;br&gt;&lt;i&gt;cálculo de rota&lt;/i&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#1a1a1a;" parent="comp" vertex="1">
          <mxGeometry x="80" y="120" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="navegador" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;(usuário)&lt;br&gt;executa a SPA React" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=left;align=right;verticalAlign=middle;spacingRight=8;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1a1a1a;strokeWidth=1.5;fontSize=11;fontColor=#1a1a1a;" parent="comp" vertex="1">
          <mxGeometry x="170" y="390" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="osm" value="&lt;b&gt;OpenStreetMap&lt;/b&gt; (terceiro)&lt;br&gt;tile.openstreetmap.org&lt;br&gt;&lt;i&gt;tiles do mapa&lt;/i&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontColor=#1a1a1a;" parent="comp" vertex="1">
          <mxGeometry x="80" y="610" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt; — container &lt;i&gt;frontend&lt;/i&gt;&lt;br&gt;gateway / proxy reverso&lt;br&gt;termina o TLS na porta 443&lt;br&gt;&lt;br&gt;serve a &lt;b&gt;SPA React&lt;/b&gt; (build estático)&lt;br&gt;Vite + TypeScript + React Router&lt;br&gt;&lt;br&gt;proxy &lt;b&gt;/api/*&lt;/b&gt; → backend:8080&lt;br&gt;&lt;span style='color:#555'&gt;(frontend/nginx.conf)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeWidth=1.5;fontSize=11;fontColor=#1a1a1a;verticalAlign=middle;strokeColor=#6c8ebf;" parent="comp" vertex="1">
          <mxGeometry x="405" y="320" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend API&lt;/b&gt; — Spring Boot 3.3 · Java 21 (monólito)&lt;br&gt;container &lt;i&gt;backend&lt;/i&gt; · porta 8080 · base &lt;b&gt;/api/v1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;EstoqueController → /bancos/{id}/estoque&lt;br&gt;RotaController → /pontos, /conexoes, /rotas&lt;br&gt;AcessoController → /acessos&lt;br&gt;DiagnosticoController → /diagnostico&lt;br&gt;BenchmarkController → /benchmarks/auditoria-telemetria&lt;br&gt;&lt;br&gt;Spring Data JPA → lê do PostgreSQL&lt;br&gt;HttpLoggingFilter → últimos 60 logs HTTP&lt;br&gt;&amp;nbsp;&amp;nbsp;(em memória, expostos em /diagnostico)&lt;br&gt;&lt;br&gt;&lt;span style='color:#c25e00'&gt;&lt;b&gt;Planejado (só contrato OpenAPI):&lt;/b&gt;&lt;br&gt;/hemocomponentes, /requisicoes,&lt;br&gt;/requisicoes/{id}/alocacoes, /entregas/{id}/leituras&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeWidth=1.5;fontSize=11;fontColor=#1a1a1a;verticalAlign=middle;strokeColor=#82b366;spacingLeft=14;spacingRight=10;" parent="comp" vertex="1">
          <mxGeometry x="800" y="290" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;(Supabase gerenciado,&lt;br&gt;via pooler · TLS)&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;tabelas lidas via JPA:&lt;br&gt;ponto_rede · conexao ·&lt;br&gt;bolsa_hemocomponente&lt;br&gt;&lt;br&gt;schema: supabase/migrations&lt;br&gt;(ddl-auto = validate)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;fontColor=#1a1a1a;" parent="comp" vertex="1">
          <mxGeometry x="1300" y="320" width="255" height="220" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;[1] HTTPS / 443&lt;/b&gt;&lt;br&gt;(TLS 1.3)" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="comp" source="navegador" target="nginx" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;[2] HTTPS / 443&lt;/b&gt;&lt;br&gt;roteirização&lt;br&gt;(timeout 8 s + fallback)" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" parent="comp" source="navegador" target="osrm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;[3] HTTPS / 443&lt;/b&gt;&lt;br&gt;tiles do mapa" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="comp" source="navegador" target="osm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;[4] HTTP/1.1 / 8080&lt;/b&gt;&lt;br&gt;proxy /api/*" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="comp" source="nginx" target="backend" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;[5] TCP (PostgreSQL) / 5432&lt;/b&gt;&lt;br&gt;JDBC com TLS" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1a1a1a;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="comp" source="backend" target="postgres" edge="1">
