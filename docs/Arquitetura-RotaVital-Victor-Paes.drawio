        <mxCell id="titulo" value="&lt;b style='font-size:17px'&gt;RotaVital — Diagrama de Arquitetura da Aplicação&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#444'&gt;Ambiente de produção projetado · fluxo da esquerda (usuário) para a direita (banco) · todo rótulo de seta segue o formato &lt;b&gt;[nº] PROTOCOLO / porta&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontColor=#1a1a1a;" parent="redes" vertex="1">
          <mxGeometry x="20" y="14" width="1200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="internet" value="&lt;b&gt;INTERNET&lt;/b&gt; (fora da VPC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" parent="redes" vertex="1">
